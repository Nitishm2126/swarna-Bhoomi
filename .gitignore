# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js build and cache outputs
/.next/
/out/
/build
/dist

# Environment variables (strictly keep secrets local)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# Vercel deployment cache
.vercel

# TypeScript build info
*.tsbuildinfo

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Python / IDE cache
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/
.idea/
*.sw?

# Runtime logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# System temporary logs
.system_generated/
